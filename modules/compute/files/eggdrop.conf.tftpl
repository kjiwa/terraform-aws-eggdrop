# Rendered by Terraform; the instance fetches it at boot. The userfile and
# channel list are rebuilt from eggdrop.tcl on every start.

loadmodule pbkdf2
loadmodule channels
loadmodule server
loadmodule ctcp
loadmodule irc

set nick "${nicks[0]}"
set altnick "${nicks[0]}?"
set realname "${nicks[0]}"
set username "${nicks[0]}"
set admin "${nicks[0]}"
set network "EFnet"
set net-type "EFnet"

# IPv4 is routed only with ipv4_enabled. Takes the AAAA record when the server
# has one, else the A record.
set prefer-ipv6 1
server add ${irc_server.host} +${irc_server.port}

set userfile "eggdrop.user"
set chanfile "eggdrop.chan"
set help-path "help/"
set mod-path "modules/"
set ssl-capath "/etc/ssl/"
set quiet-save 1
set ctcp-mode 0

logfile mco * "logs/eggdrop.log"

bind evnt - init-server eggdrop_init_server
proc eggdrop_init_server {type} {
  global botnick
  putquick "MODE $botnick +i"
}

# Every bot boots as the first nick. One that holds no listed name tries the
# next each minute; set nick also moves keep-nick's target to the claimed name.
set eggdrop_nicks {%{ for nick in nicks } ${nick}%{ endfor } }

proc eggdrop_claim_nick {minute hour day month year} {
  global eggdrop_nicks botnick
  if {![eggdrop_up] || [lsearch -exact -nocase $eggdrop_nicks $botnick] >= 0} {
    return
  }
  set ::nick [lindex $eggdrop_nicks [expr {int($minute) % [llength $eggdrop_nicks]}]]
}
bind time - "* * * * *" eggdrop_claim_nick

source scripts/eggdrop.tcl
