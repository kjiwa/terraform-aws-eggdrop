# Rendered by Terraform; the instance fetches it at boot. The userfile and
# channel list are rebuilt from eggdrop.tcl on every start.

loadmodule pbkdf2
loadmodule channels
loadmodule server
loadmodule ctcp
loadmodule irc

set eggdrop_nicks {%{ for nick in nicks } ${nick}%{ endfor } }

# eggdrop-slot writes slot.tcl before each start. Only a plain index into
# eggdrop_nicks is read from it; anything else leaves the bot a spare.
set eggdrop_boot_slot -1
if {![catch {open slot.tcl} eggdrop_slot_file]} {
  set eggdrop_slot_text [read $eggdrop_slot_file]
  close $eggdrop_slot_file
  if {[regexp -line {^set eggdrop_boot_slot ([0-9]+)$} $eggdrop_slot_text -> eggdrop_slot_index] && [scan $eggdrop_slot_index %d eggdrop_slot_index] == 1 && $eggdrop_slot_index < [llength $eggdrop_nicks]} {
    set eggdrop_boot_slot $eggdrop_slot_index
  }
}
unset -nocomplain eggdrop_slot_file eggdrop_slot_text eggdrop_slot_index

# A rehash re-reads this file, so a bot that has claimed a listed name keeps it.
if {[info exists botnick] && [lsearch -exact -nocase $eggdrop_nicks $botnick] >= 0} {
  set nick $botnick
} elseif {$eggdrop_boot_slot >= 0} {
  set nick [lindex $eggdrop_nicks $eggdrop_boot_slot]
} else {
  set nick "${nicks[0]}"
}
set altnick "${nicks[0]}?"
set username $nick
set realname $nick
set net-type "${net_type}"

# IPv4 is routed only with ipv4_enabled. Takes the AAAA record when the server
# has one, else the A record.
set prefer-ipv6 1

# Eggdrop's default is 60 s. A dead entry costs 20 s of failover time, not 60.
set server-timeout 20
set eggdrop_servers {%{ for server in irc_servers } {${server.host} +${server.port}}%{ endfor } }

# The bot's slot server is tried first and the rest follow in listed order as
# failover, so a bot with a slot connects to the server it belongs on.
set eggdrop_first_server [expr {max($eggdrop_boot_slot, 0) % [llength $eggdrop_servers]}]
foreach eggdrop_server [concat [lrange $eggdrop_servers $eggdrop_first_server end] [lrange $eggdrop_servers 0 [expr {$eggdrop_first_server - 1}]]] {
  server add [lindex $eggdrop_server 0] [lindex $eggdrop_server 1]
}
unset eggdrop_first_server eggdrop_server

set eggdrop_log_group "${log_group}"

set userfile "eggdrop.user"
set chanfile "eggdrop.chan"
set help-path "help/"
set mod-path "modules/"
set ssl-capath "/etc/ssl/"
set quiet-save 1
set ctcp-mode 0

# What the terminal console, and so the journal, prints: joins, modes, cmds,
# misc, bots, files and server notices. Not p (channel text) or m (private
# text); the logfile below still keeps m.
set console "jkcobxs"

logfile mco * "logs/eggdrop.log"

# The pending umode query's timer id, empty when none is pending.
if {![info exists eggdrop_umode_timer]} {
  set eggdrop_umode_timer ""
}

proc eggdrop_cancel_umode_query {} {
  global eggdrop_umode_timer
  if {$eggdrop_umode_timer ne ""} {
    catch {killutimer $eggdrop_umode_timer}
    set eggdrop_umode_timer ""
  }
}

bind evnt - init-server eggdrop_init_server
proc eggdrop_init_server {type} {
  global botnick eggdrop_umode_timer
  putquick "MODE $botnick +i"
  eggdrop_cancel_umode_query
  set eggdrop_umode_timer [utimer 10 eggdrop_query_umode]
}

# Eggdrop drops a line identical to one still queued, so the query waits until
# the mode changes above have gone out.
proc eggdrop_query_umode {} {
  global botnick eggdrop_umode_timer
  set eggdrop_umode_timer ""
  if {[eggdrop_up]} {
    putquick "MODE $botnick"
  }
}

# The deaf user mode keeps channel text from the bot. Its letter differs by
# ircd, so it is taken from the DEAF token of 005, which follows 001 and so
# arrives after init-server; a server without the token gets no mode. The bind
# fires before the change is stored, hence the value is read from the arguments.
# eggdrop_deaf caches the letter for the snapshot until disconnect.
if {![info exists eggdrop_deaf]} {
  set eggdrop_deaf ""
}

proc eggdrop_isupport_deaf {key isset value} {
  global botnick eggdrop_deaf
  if {$isset && [regexp {^[A-Za-z]$} $value]} {
    set eggdrop_deaf $value
    putquick "MODE $botnick +$value"
  } else {
    set eggdrop_deaf ""
  }
  return 0
}
bind isupport - DEAF eggdrop_isupport_deaf

# The bot's user modes as the server last reported them (221), "nick +modes";
# empty while disconnected.
if {![info exists eggdrop_umode]} {
  set eggdrop_umode ""
}

proc eggdrop_raw_umode {from keyword text} {
  global eggdrop_umode
  if {[regexp {^\S+ :?(\+[A-Za-z]*)$} $text -> modes]} {
    set eggdrop_umode $modes
  }
  return 0
}
bind raw - 221 eggdrop_raw_umode

# A string as a JSON literal. Non-ASCII leaves as \u escapes (with surrogate
# pairs), so the output does not depend on the process locale.
proc eggdrop_json_string {text} {
  set out ""
  foreach char [split $text ""] {
    scan $char %c code
    switch -exact -- $char {
      "\"" { append out "\\\"" }
      "\\" { append out "\\\\" }
      default {
        if {$code < 32 || $code > 126} {
          if {$code > 65535} {
            incr code -65536
            append out [format {\u%04x\u%04x} [expr {0xd800 + ($code >> 10)}] [expr {0xdc00 + ($code & 0x3ff)}]]
          } else {
            append out [format {\u%04x} $code]
          }
        } else {
          append out $char
        }
      }
    }
  }
  return "\"$out\""
}

# Empty when boot could not read the instance metadata.
proc eggdrop_instance_id {} {
  if {[info exists ::env(EGGDROP_INSTANCE_ID)]} {
    return $::env(EGGDROP_INSTANCE_ID)
  }
  return ""
}

# One CloudWatch Logs line per server event: "event host:port text", with "-"
# for an event that has no target. The trailing & keeps the call from blocking
# PING replies. The stream is named after the instance and created at boot.
proc eggdrop_server_event {event target text} {
  global eggdrop_region eggdrop_log_group
  set instance_id [eggdrop_instance_id]
  if {$instance_id eq ""} {
    return
  }
  if {$target eq ""} {
    set target -
  }
  set message [string trim "$event $target $text"]
  set events "\[{\"timestamp\":[clock milliseconds],\"message\":[eggdrop_json_string $message]}\]"
  catch {
    exec aws logs put-log-events --region $eggdrop_region \
      --log-group-name $eggdrop_log_group \
      --log-stream-name $instance_id \
      --log-events $events > /dev/null 2> /dev/null &
  }
}

# serveraddress is empty until the server's welcome, so the entry being tried
# comes from the "Trying server" line.
if {![info exists eggdrop_attempt]} {
  set eggdrop_attempt ""
}

proc eggdrop_current_target {} {
  global eggdrop_attempt
  if {$::serveraddress ne ""} {
    return $::serveraddress
  }
  return $eggdrop_attempt
}

# The bot's own server log is level s on channel *. Channel text is level p,
# private text m (a notice to the bot carries both), and a server NOTICE starts
# with "-NOTICE-", so text from the network cannot forge a server event. The
# bind masks only narrow what these procs see.
proc eggdrop_server_log {level channel text prefix} {
  return [expr {$level eq "s" && $channel eq "*" && [string first $prefix $text] == 0}]
}

proc eggdrop_log_trying {level channel text} {
  global eggdrop_attempt
  if {![eggdrop_server_log $level $channel $text "Trying server "]} {
    return
  }
  set eggdrop_attempt [lindex $text 2]
  eggdrop_server_event trying $eggdrop_attempt ""
}
bind log - {* Trying server *} eggdrop_log_trying

proc eggdrop_log_failed {level channel text} {
  if {![eggdrop_server_log $level $channel $text "Failed connect to "] && ![eggdrop_server_log $level $channel $text "Timeout: connect "]} {
    return
  }
  eggdrop_server_event failed [eggdrop_current_target] $text
}
bind log - {* Failed connect to *} eggdrop_log_failed
bind log - {* Timeout: connect *} eggdrop_log_failed

# A server that drops the bot before its welcome logs only this line; once
# online, disconnect-server reports it. Both fire before server-online is
# reset, so the check below logs each disconnect once.
proc eggdrop_log_dropped {level channel text} {
  if {![eggdrop_server_log $level $channel $text "Disconnected from "] || [set ::server-online] > 0} {
    return
  }
  eggdrop_server_event disconnected [eggdrop_current_target] $text
}
bind log - {* Disconnected from *} eggdrop_log_dropped

proc eggdrop_event_accepted {type} {
  eggdrop_server_event accepted $::serveraddress $::server
}
bind evnt - init-server eggdrop_event_accepted

proc eggdrop_event_disconnected {type} {
  set ::eggdrop_umode ""
  set ::eggdrop_deaf ""
  eggdrop_cancel_umode_query
  eggdrop_server_event disconnected $::serveraddress ""
}
bind evnt - disconnect-server eggdrop_event_disconnected

# A server that refuses the bot says why in ERROR or 463 (not permitted) and
# 465 (banned); the built-in handlers still run.
proc eggdrop_raw_refused {from keyword text} {
  if {$keyword ne "ERROR"} {
    regsub {^\S+ } $text "" text
  }
  eggdrop_server_event refused [eggdrop_current_target] "$keyword [string trimleft $text :]"
  return 0
}
bind raw - ERROR* eggdrop_raw_refused
bind raw - 463 eggdrop_raw_refused
bind raw - 465 eggdrop_raw_refused

# A bot with no slot file boots as the first nick. One that holds no listed
# name claims the first listed name no one in its channels wears; set nick also moves
# keep-nick's target to the claimed name. The new ident and realname apply at
# the next connect.
proc eggdrop_claim_nick {minute hour day month year} {
  global eggdrop_nicks botnick
  if {![eggdrop_up] || [lsearch -exact -nocase $eggdrop_nicks $botnick] >= 0} {
    return
  }
  foreach channel [channels] {
    if {![botonchan $channel]} {
      return
    }
  }
  foreach name $eggdrop_nicks {
    set taken 0
    foreach channel [channels] {
      if {[onchan $name $channel]} {
        set taken 1
      }
    }
    if {!$taken} {
      set ::nick $name
      set ::username $name
      set ::realname $name
      return
    }
  }
}
bind time - "* * * * *" eggdrop_claim_nick

# The bot wearing eggdrop_nicks[i] belongs on eggdrop_servers[i mod length], so
# one server outage leaves the other bots opped. eggdrop_slot is -1 for a bot
# with no listed name; eggdrop_slot_server is empty for it and for a single
# server, where there is nothing to be on or off.
proc eggdrop_slot {} {
  global eggdrop_nicks botnick
  return [lsearch -exact -nocase $eggdrop_nicks $botnick]
}

proc eggdrop_slot_server {} {
  global eggdrop_servers
  set slot [eggdrop_slot]
  if {$slot < 0 || [llength $eggdrop_servers] < 2} {
    return ""
  }
  return [lindex $eggdrop_servers [expr {$slot % [llength $eggdrop_servers]}]]
}

# 1 when the bot is on its slot server or has none.
proc eggdrop_on_slot_server {} {
  set server [eggdrop_slot_server]
  if {$server eq ""} {
    return 1
  }
  lassign $server host port
  return [string equal -nocase $::serveraddress "$host:$port"]
}

%{ if length(irc_servers) > 1 ~}
# A bot jumps only on minutes whose number mod the bot count is its slot, so
# two bots never jump together, at most once per ${slot_gate_seconds} s, and only while another
# listed bot is opped in every channel, with at least one channel: moving never
# drops the last op. A bot that failed over returns to its slot server once it
# has waited out the gate.
if {![info exists eggdrop_moved_at]} {
  set eggdrop_moved_at 0
}

proc eggdrop_take_server {minute hour day month year} {
  global eggdrop_nicks eggdrop_moved_at botnick
  set server [eggdrop_slot_server]
  if {![eggdrop_up] || $server eq ""} {
    return
  }
  if {[scan $minute %d] % [llength $eggdrop_nicks] != [eggdrop_slot]} {
    return
  }
  if {[unixtime] - $eggdrop_moved_at < ${slot_gate_seconds} || [llength [channels]] == 0} {
    return
  }
  if {[eggdrop_on_slot_server]} {
    return
  }
  lassign $server host port
  foreach peer $eggdrop_nicks {
    if {[string equal -nocase $peer $botnick]} {
      continue
    }
    set opped 1
    foreach channel [channels] {
      if {![isop $peer $channel]} {
        set opped 0
      }
    }
    if {$opped} {
      set eggdrop_moved_at [unixtime]
      jump $host $port
      return
    }
  }
}
bind time - "* * * * *" eggdrop_take_server

%{ endif ~}
# Whether each listed server welcomes this bot is probed once a day and kept
# in eggdrop_probe_file for the snapshot. A probe never joins a channel. It runs
# in the background so PING replies are not blocked, on the bot's own slot
# minute, and only once the bot has been online 10 min; eggdrop_probe_started
# holds a probe that wrote nothing back for an hour.
set eggdrop_probe_file "/opt/eggdrop/probes.json"
if {![info exists eggdrop_probe_started]} {
  set eggdrop_probe_started 0
}

proc eggdrop_probes_json {} {
  global eggdrop_probe_file
  if {[catch {open $eggdrop_probe_file} file]} {
    return "\{\}"
  }
  set body [string trim [read $file]]
  close $file
  if {$body eq ""} {
    return "\{\}"
  }
  return $body
}

proc eggdrop_probe_servers {minute hour day month year} {
  global eggdrop_nicks eggdrop_servers eggdrop_probe_file eggdrop_probe_started
  set now [unixtime]
  if {![eggdrop_up] || [eggdrop_slot] < 0 || $now - [set ::server-online] < 600} {
    return
  }
  if {[scan $minute %d] % [llength $eggdrop_nicks] != [eggdrop_slot]} {
    return
  }
  if {$now - $eggdrop_probe_started < 3600} {
    return
  }
  if {[file exists $eggdrop_probe_file] && $now - [file mtime $eggdrop_probe_file] < 86400} {
    return
  }
  set eggdrop_probe_started $now
  set entries {}
  foreach server $eggdrop_servers {
    lassign $server host port
    lappend entries "$host:$port"
  }
  if {[catch {
    exec python3 /opt/eggdrop/eggdrop-probe $eggdrop_probe_file {*}$entries \
      > /dev/null 2> /dev/null &
  } reason]} {
    eggdrop_server_event probe_failed "" "exec: $reason"
  }
}
bind time - "* * * * *" eggdrop_probe_servers

# Releases this instance's launch hook once the bot is in every channel, or
# 300 s after connecting. The end of a channel's NAMES list, which follows the
# bot's own join, and the minute tick both try. The guard keeps a rehash, and
# the second of the two, from running it again. A failed call is retried a few
# times: an instance that is no longer waiting (long-running, or launched
# before the hook existed) never succeeds.
if {![info exists eggdrop_ready_sent]} {
  set eggdrop_ready_sent 0
  set eggdrop_ready_failures 0
}

proc eggdrop_try_release {} {
  global eggdrop_ready_sent eggdrop_ready_failures
  if {$eggdrop_ready_sent || $eggdrop_ready_failures >= 5 || ![eggdrop_up]} {
    return
  }
  set joined 1
  foreach channel [channels] {
    if {![botonchan $channel]} {
      set joined 0
    }
  }
  if {!$joined && [unixtime] - [set ::server-online] < 300} {
    return
  }
  set eggdrop_ready_sent 1
  if {[catch {exec /usr/local/bin/eggdrop-ready ${asg_name} ${lifecycle_hook_name}} err]} {
    set eggdrop_ready_sent 0
    incr eggdrop_ready_failures
    putlog "eggdrop-ready failed: $err"
  }
}

proc eggdrop_release_launch {minute hour day month year} {
  eggdrop_try_release
}
bind time - "* * * * *" eggdrop_release_launch

proc eggdrop_release_on_names {from keyword text} {
  eggdrop_try_release
  return 0
}
bind raw - 366 eggdrop_release_on_names

source scripts/eggdrop.tcl
