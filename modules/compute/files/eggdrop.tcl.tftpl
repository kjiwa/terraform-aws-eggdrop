# Rendered by Terraform. Users, channels, the heartbeat and the status link.

set eggdrop_region "${region}"
set eggdrop_namespace "${metric_namespace}"
set eggdrop_domain "${domain_name}"
set eggdrop_owner "${owner}"
set eggdrop_token_ttl 43200

# This script is applied to a running bot, whose conf is older. Each symbol the
# conf defines and this script uses is stubbed when the conf lacks it, so the
# heartbeat keeps publishing. A stub leaves out only what the old conf cannot
# supply: no instance id means no snapshot and no probes.
if {![info exists eggdrop_nicks]} {
  set eggdrop_nicks {}
}
foreach {eggdrop_name eggdrop_body} {
  eggdrop_on_slot_server {return 1}
  eggdrop_instance_id {return ""}
  eggdrop_json_string {return "\"\""}
  eggdrop_probes_json {return "\{\}"}
} {
  if {![llength [info procs $eggdrop_name]]} {
    proc $eggdrop_name {args} $eggdrop_body
  }
}
unset eggdrop_name eggdrop_body

# Answer only the status command: every other built-in /msg command is
# unbound, so a stranger's message gets no response.
foreach eggdrop_bind [binds msg] {
  lassign $eggdrop_bind eggdrop_type eggdrop_flags eggdrop_mask eggdrop_hits eggdrop_proc
  unbind $eggdrop_type $eggdrop_flags $eggdrop_mask $eggdrop_proc
}
unset -nocomplain eggdrop_bind eggdrop_type eggdrop_flags eggdrop_mask eggdrop_hits eggdrop_proc

# Users carry no global flags: ops are granted per channel below, and the
# owner is recognised by handle, so nobody holds +n. A rehash re-reads the
# userfile but never removes users, so every handle is dropped first and the
# rendered roster is the whole truth.
proc eggdrop_load_users {type} {
  foreach handle [userlist] {
    deluser $handle
  }
  foreach {handle masks} {
%{ for handle, masks in users ~}
    {${handle}} {${join(" ", masks)}}
%{ endfor ~}
  } {
    adduser $handle [lindex $masks 0]
    foreach mask [lrange $masks 1 end] {
      setuser $handle HOSTS $mask
    }
  }
  adduser peers [lindex {${join(" ", peer_masks)}} 0]
  foreach mask [lrange {${join(" ", peer_masks)}} 1 end] {
    setuser peers HOSTS $mask
  }
  foreach channel {${join(" ", channels)}} {
    chattr peers |+fao $channel
  }
  foreach {handle channel} {
%{ for grant in channel_ops ~}
    {${grant.handle}} {${grant.channel}}
%{ endfor ~}
  } {
    chattr $handle |+fao $channel
  }
}
bind evnt - userfile-loaded eggdrop_load_users

# A reload re-matches members lazily and rechecks nothing, so members who now
# match the roster are opped here once it has settled.
proc eggdrop_op_members {} {
  foreach channel [channels] {
    if {![botisop $channel]} {
      continue
    }
    foreach nick [chanlist $channel] {
      if {[isop $nick $channel]} {
        continue
      }
      set handle [nick2hand $nick $channel]
      if {[matchattr $handle |o $channel] && [matchattr $handle |a $channel]} {
        pushmode $channel +o $nick
      }
    }
  }
}

proc eggdrop_schedule_op_members {type} {
  utimer 5 eggdrop_op_members
}
bind evnt - userfile-loaded eggdrop_schedule_op_members

set eggdrop_channels {
%{ for channel in channels ~}
  {${channel}}
%{ endfor ~}
}

# A rehash neither parts nor forgets a channel the config dropped.
proc eggdrop_prune_channels {type} {
  global eggdrop_channels
  set wanted [string tolower $eggdrop_channels]
  foreach channel [channels] {
    if {[lsearch -exact $wanted [string tolower $channel]] < 0} {
      channel remove $channel
    }
  }
}
bind evnt - userfile-loaded eggdrop_prune_channels

%{ for channel in channels ~}
channel add ${channel} {
  chanmode "+nt"
}
channel set ${channel} +protectops
%{ endfor ~}

# server-online holds the time of the server's welcome, and 0 while
# disconnected. A connected bot publishes SiteUp 1 and a disconnected one
# publishes nothing, so the Minimum statistic is 1 while any bot is connected.
proc eggdrop_up {} {
  return [expr {[set ::server-online] > 0}]
}

# GroupSize counts the listed nicks present in any of the bot's channels, the
# bot included. It falls below the bot count when a bot is down, split off or
# on another network.
proc eggdrop_group_size {} {
  global eggdrop_nicks
  set size 0
  foreach nick $eggdrop_nicks {
    foreach channel [channels] {
      if {[onchan $nick $channel]} {
        incr size
        break
      }
    }
  }
  return $size
}

# OnSlotServer is 0 while the bot sits off its slot server: GroupSize reads
# the same with both bots on one server.
proc eggdrop_heartbeat {minute hour day month year} {
  global eggdrop_region eggdrop_namespace
  if {![eggdrop_up]} {
    return
  }
  set size [eggdrop_group_size]
  set on_slot [eggdrop_on_slot_server]
  catch {
    exec aws cloudwatch put-metric-data --region $eggdrop_region \
      --namespace $eggdrop_namespace \
      --metric-data MetricName=SiteUp,Value=1 MetricName=GroupSize,Value=$size MetricName=OnSlotServer,Value=$on_slot \
      > /dev/null 2> /dev/null &
  }
}
bind time - "* * * * *" eggdrop_heartbeat

proc eggdrop_channel_json {channel with_members} {
  set joined [botonchan $channel]
  set opped [expr {$joined && [botisop $channel]}]
  set json "\{\"name\":[eggdrop_json_string $channel],\"joined\":[expr {$joined ? "true" : "false"}],\"opped\":[expr {$opped ? "true" : "false"}]"
  if {$with_members} {
    append json ",\"members\":[expr {$joined ? [llength [chanlist $channel]] : 0}]"
  }
  return "$json\}"
}

# What the status page shows of this bot. "updated" is left out so that an
# unchanged bot compares equal; member counts are left out of the compared
# form because they churn on a busy channel.
proc eggdrop_snapshot_body {with_members} {
  set channels {}
  foreach channel [lsort [channels]] {
    lappend channels [eggdrop_channel_json $channel $with_members]
  }
  set online [set ::server-online]
  return "\"nick\":[eggdrop_json_string $::botnick],\"botname\":[eggdrop_json_string $::botname],\"server_entry\":[eggdrop_json_string $::serveraddress],\"server_name\":[eggdrop_json_string $::server],\"online_since\":$online,\"on_slot\":[expr {[eggdrop_on_slot_server] ? "true" : "false"}],\"channels\":\[[join $channels ,]\],\"probes\":[eggdrop_probes_json]"
}

if {![info exists eggdrop_snapshot_last]} {
  set eggdrop_snapshot_last ""
  set eggdrop_snapshot_at 0
}

# Written to bots/<instance-id>.json when its stable fields change and at least
# every 900 s, with member counts. Unlike the heartbeat it also runs while
# disconnected. A bot that never learned its instance id writes nothing.
proc eggdrop_snapshot {minute hour day month year} {
  global eggdrop_snapshot_last eggdrop_snapshot_at
  set instance_id [eggdrop_instance_id]
  if {$instance_id eq "" || ![info exists ::env(EGGDROP_BUCKET)]} {
    return
  }
  set stable [eggdrop_snapshot_body 0]
  set now [unixtime]
  if {$stable eq $eggdrop_snapshot_last && $now - $eggdrop_snapshot_at < 900} {
    return
  }
  set json "\{[eggdrop_snapshot_body 1],\"updated\":$now\}"
  if {![catch {
    exec aws s3 cp - s3://$::env(EGGDROP_BUCKET)/bots/$instance_id.json \
      --content-type application/json --only-show-errors << $json \
      > /dev/null 2> /dev/null &
  }]} {
    set eggdrop_snapshot_last $stable
    set eggdrop_snapshot_at $now
  }
}
bind time - "* * * * *" eggdrop_snapshot

proc eggdrop_status {nick uhost handle text} {
  global eggdrop_domain eggdrop_owner eggdrop_token_ttl
  if {$handle ne $eggdrop_owner} {
    return 1
  }
  if {[catch {exec python3 /opt/eggdrop/eggdrop-token /opt/eggdrop/status.key $eggdrop_token_ttl} token]} {
    putserv "NOTICE $nick :could not mint a token"
    return 1
  }
  putserv "NOTICE $nick :https://$eggdrop_domain/signin#token=$token (valid for 12 hours)"
  return 1
}
bind msg - status eggdrop_status
