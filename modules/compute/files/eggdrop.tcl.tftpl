# Rendered by Terraform. Users, channels, the heartbeat and the status link.

set eggdrop_region "${region}"
set eggdrop_namespace "${metric_namespace}"
set eggdrop_domain "${domain_name}"
set eggdrop_owner "${owner}"
set eggdrop_token_ttl 43200

# Answer only the status command: every other built-in /msg command is
# unbound, so a stranger's message gets no response.
foreach eggdrop_bind [binds msg] {
  lassign $eggdrop_bind eggdrop_type eggdrop_flags eggdrop_mask eggdrop_hits eggdrop_proc
  unbind $eggdrop_type $eggdrop_flags $eggdrop_mask $eggdrop_proc
}
unset -nocomplain eggdrop_bind eggdrop_type eggdrop_flags eggdrop_mask eggdrop_hits eggdrop_proc

# Users carry no global flags: ops are granted per channel below, and the
# owner is recognised by handle, so nobody holds +n.
proc eggdrop_load_users {type} {
  foreach {handle masks} {
%{ for handle, masks in users ~}
    {${handle}} {${join(" ", masks)}}
%{ endfor ~}
  } {
    adduser $handle [lindex $masks 0]
    foreach mask [lrange $masks 1 end] {
      setuser $handle HOSTS $mask
    }
  }
  foreach {handle channel} {
%{ for grant in channel_ops ~}
    {${grant.handle}} {${grant.channel}}
%{ endfor ~}
  } {
    chattr $handle |+fao $channel
  }
}
bind evnt - userfile-loaded eggdrop_load_users

%{ for channel in channels ~}
channel add ${channel} {
  chanmode "+nt"
}
channel set ${channel} +protectops
%{ endfor ~}

# SiteUp is 1 while the bot is registered with the IRC server. server-online
# holds the time of the server's welcome, and 0 while disconnected; a bot that
# is down publishes nothing, which the alarm reads as down too.
proc eggdrop_up {} {
  return [expr {[set ::server-online] > 0}]
}

proc eggdrop_heartbeat {minute hour day month year} {
  global eggdrop_region eggdrop_namespace
  catch {
    exec aws cloudwatch put-metric-data --region $eggdrop_region \
      --namespace $eggdrop_namespace --metric-name SiteUp --value [eggdrop_up] \
      > /dev/null 2> /dev/null &
  }
}
bind time - "* * * * *" eggdrop_heartbeat

proc eggdrop_status {nick uhost handle text} {
  global eggdrop_domain eggdrop_owner eggdrop_token_ttl
  if {$handle ne $eggdrop_owner} {
    return 1
  }
  if {[catch {exec python3 /opt/eggdrop/eggdrop-token /opt/eggdrop/status.key $eggdrop_token_ttl} token]} {
    putserv "NOTICE $nick :could not mint a token"
    return 1
  }
  putserv "NOTICE $nick :https://$eggdrop_domain/signin#token=$token (valid for 12 hours)"
  return 1
}
bind msg - status eggdrop_status
